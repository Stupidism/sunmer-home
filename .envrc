# Repo-level gh account selection via direnv.
# Account id is provided by local ignored file: .envrc.local
if [ -f .envrc.local ]; then
  source .envrc.local
fi

if command -v gh >/dev/null 2>&1; then
  if [ -n "${GH_ACCOUNT:-}" ]; then
    token="$(gh auth token -h github.com -u "${GH_ACCOUNT}" 2>/dev/null || true)"
    if [ -n "${token}" ]; then
      export GH_HOST="github.com"
      export GH_TOKEN="${token}"
    fi

    gh() {
      local current_login
      current_login="$(command gh api user -q .login 2>/dev/null || true)"
      if [ "${current_login}" != "${GH_ACCOUNT}" ]; then
        command gh auth switch -u "${GH_ACCOUNT}" >/dev/null 2>&1 || true
      fi
      command gh "$@"
    }
  fi
fi
