# Use the Stupidism GitHub account token for this repository.
# gh CLI prefers GH_TOKEN over globally active account.
if command -v gh >/dev/null 2>&1; then
  token="$(gh auth token -h github.com -u Stupidism 2>/dev/null || true)"
  if [ -n "${token}" ]; then
    export GH_HOST="github.com"
    export GH_TOKEN="${token}"
  fi
fi

# Optional local overrides (not committed).
if [ -f .envrc.local ]; then
  source .envrc.local
fi
