# Repo-level gh account selection via direnv.
# Account id is provided by local ignored file: .envrc.local
if [ -f .envrc.local ]; then
  source .envrc.local
fi

if command -v gh >/dev/null 2>&1; then
  if [ -n "${GH_ACCOUNT:-}" ]; then
    token="$(gh auth token -h github.com -u "${GH_ACCOUNT}" 2>/dev/null || true)"
    if [ -n "${token}" ]; then
      export GH_HOST="github.com"
      export GH_TOKEN="${token}"
    fi
  fi
fi
