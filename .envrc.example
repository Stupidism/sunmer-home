# Copy this file to .envrc and run `direnv allow`.
# This keeps .envrc local-only while still standardizing setup.
if command -v gh >/dev/null 2>&1; then
  token="$(gh auth token -h github.com -u Stupidism 2>/dev/null || true)"
  if [ -n "${token}" ]; then
    export GH_HOST="github.com"
    export GH_TOKEN="${token}"
  fi
fi

# Optional local overrides (not committed).
if [ -f .envrc.local ]; then
  source .envrc.local
fi
