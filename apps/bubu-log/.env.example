# ---- Auth baseline (required) ----
AUTH_SECRET=replace-with-secure-random
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:1030
# AUTH_URL can be used as an alternative to NEXTAUTH_URL

# ---- OAuth providers (optional; enable by setting both id + secret) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

WECHAT_APP_ID=
WECHAT_APP_SECRET=
# WECHAT_PLATFORM_TYPE=WebsiteApp
# WECHAT_REDIRECT_URI=

# ---- Other services ----
DEEPSEEK_API_KEY=
